# Release lanes (see the maybeitssoftware mobile release runbook). Credentials
# come from the environment: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT
# (base64 .p8), MATCH_PASSWORD, PLAY_SERVICE_ACCOUNT_JSON, and for Android a
# key.properties next to android/app (the shared upload key).

APP_ID = "uk.co.maybeitssoftware.librelog"
TEAM_ID = ENV["TEAM_ID"] || "6NQNU5YSC2"
ROOT = File.expand_path("..", __dir__)

# The App Store Connect key, from ASC_* or, as the shared asc.env spells
# them, APP_STORE_CONNECT_API_KEY_*. The content may be base64 or the .p8
# itself, with real or escaped newlines.
def asc_key
  env = ->(short, long) { ENV[short].to_s.empty? ? ENV[long].to_s : ENV[short].to_s }
  content = env.call("ASC_KEY_CONTENT", "APP_STORE_CONNECT_API_KEY_CONTENT")
  # Locally it's easier to point at the downloaded AuthKey_XXXX.p8.
  path = env.call("ASC_KEY_PATH", "APP_STORE_CONNECT_API_KEY_PATH")
  content = File.read(File.expand_path(path)) if content.empty? && !path.empty?
  missing = { "ASC_KEY_ID" => env.call("ASC_KEY_ID", "APP_STORE_CONNECT_API_KEY_ID"),
              "ASC_ISSUER_ID" => env.call("ASC_ISSUER_ID", "APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
              "ASC_KEY_CONTENT or ASC_KEY_PATH" => content }.select { |_, v| v.empty? }.keys
  UI.user_error!("App Store Connect key not set: #{missing.join(', ')} (or the APP_STORE_CONNECT_API_KEY_* spellings)") unless missing.empty?
  pem = content.include?("BEGIN PRIVATE KEY")
  app_store_connect_api_key(
    key_id: env.call("ASC_KEY_ID", "APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: env.call("ASC_ISSUER_ID", "APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
    key_content: pem ? content.gsub('\\n', "\n") : content, is_key_content_base64: !pem,
  )
end

# The Play service account, from PLAY_SERVICE_ACCOUNT_JSON or a file named
# by PLAY_SERVICE_ACCOUNT_FILE.
def play_key
  file = ENV["PLAY_SERVICE_ACCOUNT_FILE"].to_s
  file.empty? ? { json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"] } : { json_key: file }
end

platform :android do
  # Version codes follow the Actions workflow's scheme (android-internal.yml):
  # the UTC date and a two-digit number, e.g. 2026102105, higher than any
  # upload that day. Anything below today's date would sit under codes
  # already on Play.
  desc "Build a signed bundle and put it on the Play internal track for testers"
  lane :internal do |opts|
    name = opts[:version_name].to_s
    code = opts[:version_code].to_s
    UI.user_error!("version_name: must look like 1.2.3 (got #{name.inspect})") unless name.match?(/\A\d+(\.\d+){0,2}\z/)
    UI.user_error!("version_code: must be a positive integer (got #{code.inspect})") unless code.match?(/\A[1-9]\d{0,9}\z/)
    floor = Time.now.utc.strftime("%Y%m%d00").to_i
    UI.user_error!("version_code: use today's UTC date and a two-digit number, at least #{floor + 1}") if code.to_i <= floor
    UI.user_error!("version_code: Play's limit is 2100000000") if code.to_i > 2_100_000_000
    sh("cd #{ROOT} && scripts/build-android.sh")
    sh("cd #{ROOT}/android && ./gradlew -q bundleRelease -PversionCode=#{code} -PversionName=#{name}")
    upload_to_play_store(
      track: "internal",
      # Straight to internal testers; pass release_status:draft to hold it
      # for a manual rollout in Play Console.
      release_status: opts[:release_status] || "completed",
      aab: "#{ROOT}/android/app/build/outputs/bundle/release/app-release.aab",
      **play_key,
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end

  desc "Upload the store listing: text, icon, feature graphic and screenshots (no build)"
  lane :listing do
    upload_to_play_store(
      **play_key,
      metadata_path: "#{ROOT}/fastlane/metadata/android",
      # supply attaches the listing to a release; production has none yet,
      # so it goes with the latest internal one.
      track: "internal",
      skip_upload_apk: true, skip_upload_aab: true, skip_upload_changelogs: true,
    )
  end
end

platform :ios do
  # The Apple builds share one bundle id and one App Store Connect record
  # (universal purchase): "ios" archives for iPhone and iPad, "macos" for the
  # Mac App Store. Each has its own match profile; the Mac one also needs the
  # Mac Installer Distribution certificate, which signs the uploaded .pkg.
  APPLE_PLATFORMS = %w[ios macos].freeze

  def apple_platform(opts)
    platform = (opts[:platform] || "ios").to_s
    UI.user_error!("platform: must be ios or macos (got #{platform.inspect})") unless APPLE_PLATFORMS.include?(platform)
    platform
  end

  def apple_profile(platform)
    platform == "macos" ? "match AppStore #{APP_ID} macos" : "match AppStore #{APP_ID}"
  end

  def apple_certs(platform, key, readonly:)
    certs = { type: "appstore", platform: platform, app_identifier: APP_ID, api_key: key, readonly: readonly }
    certs[:additional_cert_types] = ["mac_installer_distribution"] if platform == "macos"
    # CI and local runs both clone the certs repo over SSH (CI via the
    # MATCH_GIT_SSH_KEY deploy key); MATCH_GIT_URL overrides the Matchfile if set.
    certs[:git_url] = ENV["MATCH_GIT_URL"] unless ENV["MATCH_GIT_URL"].to_s.empty?
    match(**certs)
  end

  # Builds the Rust core, archives at the given numbers and, unless
  # upload:false, sends it to TestFlight. A version name of nil keeps
  # project.yml's MARKETING_VERSION.
  def apple_release(platform:, name:, number:, upload: true)
    key = asc_key
    setup_ci if ENV["CI"]
    apple_certs(platform, key, readonly: true)
    sh("cd #{ROOT} && scripts/build-apple.sh && cd apple && xcodegen -q")
    profile = apple_profile(platform)
    version = name ? "MARKETING_VERSION=#{name} " : ""
    build_app(
      project: "#{ROOT}/apple/Librelog.xcodeproj", scheme: "Librelog",
      destination: "generic/platform=#{platform == 'macos' ? 'macOS' : 'iOS'}",
      # The target is multiplatform; gym only packages a .pkg (not an .ipa)
      # for one when told the SDK.
      sdk: platform == "macos" ? "macosx" : "iphoneos",
      export_method: "app-store",
      output_directory: "#{ROOT}/apple/build/#{platform}", clean: true,
      xcargs: "#{version}CURRENT_PROJECT_VERSION=#{number} " \
              "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='#{profile}'",
      export_options: { provisioningProfiles: { APP_ID => profile } },
    )
    return unless upload
    if platform == "macos"
      upload_to_testflight(api_key: key, app_identifier: APP_ID, app_platform: "osx",
                           pkg: lane_context[SharedValues::PKG_OUTPUT_PATH],
                           skip_waiting_for_build_processing: true)
    else
      upload_to_testflight(api_key: key, app_identifier: APP_ID, skip_waiting_for_build_processing: true)
    end
  end

  desc "Fetch (or, with readonly:false, create) the App Store signing for platform:ios (default) or platform:macos"
  lane :certificates do |opts|
    apple_certs(apple_platform(opts), asc_key, readonly: opts[:readonly] != false)
  end

  desc "Archive for platform:ios (default) or platform:macos at the next TestFlight build number and upload it"
  lane :internal do |opts|
    platform = apple_platform(opts)
    number = opts[:build_number] || (latest_testflight_build_number(
      api_key: asc_key, app_identifier: APP_ID, platform: platform == "macos" ? "osx" : "ios", initial_build_number: 0,
    ) + 1)
    apple_release(platform: platform, name: opts[:version_name], number: number, upload: opts[:upload] != false)
  end

  # Called by .github/workflows/apple-testflight.yml, which picks the numbers:
  # version_name is CFBundleShortVersionString, build_number CFBundleVersion
  # (the same UTC-date scheme as Android's version codes).
  desc "Archive platform:ios or platform:macos at version_name/build_number and upload it to TestFlight"
  lane :release do |opts|
    name = opts[:version_name].to_s
    number = opts[:build_number].to_s
    UI.user_error!("version_name: must look like 1.2.3 (got #{name.inspect})") unless name.match?(/\A\d+(\.\d+){0,2}\z/)
    UI.user_error!("build_number: must be a positive integer (got #{number.inspect})") unless number.match?(/\A[1-9]\d*\z/)
    apple_release(platform: apple_platform(opts), name: name, number: number)
  end

  desc "Upload the App Store listing: text, review notes and screenshots (no build, no submission)"
  lane :listing do
    deliver(
      api_key: asc_key,
      app_identifier: APP_ID,
      metadata_path: "#{ROOT}/fastlane/metadata",
      screenshots_path: "#{ROOT}/fastlane/screenshots",
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
    )
  end
end
